{# Every number comes from n("id"). Digits typed here must sit inside a data-label element (period names, form names). #}
{% macro L(text) %}<span data-label>{{ text }}</span>{% endmacro %}
{% macro tag(kind) %}<span class="tag tag-{{ kind|lower }}">{{ kind }}</span>{% endmacro %}
{% macro bar(pct, cls="") %}
<svg class="bar" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-bg" width="100" height="4"/><rect class="bar-fg {{ cls }}" width="{{ pct }}" height="4"/></svg>
{%- endmacro %}
{% macro stack(parts) %}
{% set ns = namespace(x=0) %}
<svg class="bar bar-stack" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-bg" width="100" height="4"/>{% for pct, cls in parts %}<rect class="bar-fg {{ cls }}" x="{{ ns.x }}" width="{{ [pct - 0.4, 0.2]|max }}" height="4"/>{% set ns.x = ns.x + pct %}{% endfor %}</svg>
{%- endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.description }}">
<meta name="color-scheme" content="dark">
<meta name="robots" content="index,follow">
<link rel="canonical" href="{{ site.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ site.title }}">
<meta property="og:description" content="{{ site.description }}">
<meta property="og:url" content="{{ site.url }}">
<meta property="og:image" content="{{ share.image }}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="{{ share.width }}">
<meta property="og:image:height" content="{{ share.height }}">
<meta property="og:image:alt" content="{{ site.image_alt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ site.title }}">
<meta name="twitter:description" content="{{ site.description }}">
<meta name="twitter:image" content="{{ share.image }}">
<meta name="twitter:image:alt" content="{{ site.image_alt }}">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/static/app.css?v={{ asset_version }}">
<script src="/static/app.js?v={{ asset_version }}" defer></script>
</head>
<body data-market="{{ market.state if market else 'off' }}">
<a class="skip" href="#main">Skip to the numbers</a>

{#- A final prospectus states its own date; the SEC's filing date can be a day later. -#}
{% macro filed_word(doc) %}{% if doc.form == "424B4" and doc.id != "final" %}dated{% else %}filed{% endif %}{% endmacro %}
<header class="top hero">
  <div class="brand">
    <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect class="mk-frame" x="1" y="1" width="30" height="30" rx="4"/><path class="mk-line" d="M6 24 H12 V18 H18 V12 H26"/><circle class="mk-dot" cx="26" cy="12" r="2.4"/></svg>
    <h1><span class="w1">ANTHROPIC</span> <span class="w2">IPO</span> <span class="w3">WATCH</span></h1>
  </div>
  <p class="tagline">Anthropic's IPO in numbers you can trace<span class="wide">: every figure opens the SEC filing it came from</span>.</p>
  <p class="disclaimer">Unofficial · not affiliated with Anthropic · not investment advice</p>
  {% set short_title = document.title.split(", ")[-1] %}
  <p class="uptodate">
    {%- if not filings -%}
      figures: {{ L(short_title) }}, {{ filed_word(document) }} {{ n("doc.filed_date", "short") }}
    {%- elif not filings.filings -%}
      <span class="wait">SEC list unavailable</span> · figures: {{ L(short_title) }}, {{ filed_word(document) }} {{ n("doc.filed_date", "short") }}
    {%- elif newer and price_used and filings.prospectus == newer -%}
      <span class="ok">● final price read</span> from {{ L(newer.name) }}, {{ L(day(newer.filed, "short")) }} · other figures: {{ L(short_title) }}
    {%- elif newer -%}
      <span class="live">new filing</span> {{ L(newer.name) }}, {{ L(day(newer.filed, "short")) }} · not read yet
    {%- elif filings.state == "unavailable" -%}
      <span class="wait">last SEC check failed</span> {{ L(clock(filings.checked)) }} · figures: {{ L(short_title) }}, {{ filed_word(document) }} {{ n("doc.filed_date", "short") }}
    {%- else -%}
      <span class="ok">● up to date</span> · SEC checked <span data-label class="uptodate-at">{{ clock(filings.checked) }}</span> · figures: {{ L(short_title) }}, {{ n("doc.filed_date", "short") }}
    {%- endif -%}
  </p>
</header>

<section class="glance" aria-label="The IPO at a glance">
  <dl class="stats">
    <div><dt>{% if priced %}IPO price{% else %}price range{% endif %}</dt><dd>{% if priced %}{{ n(price_ref) }}{% else %}{{ n("offering.price_low") }}<span class="to">–</span>{{ n("offering.price_high") }}{% endif %}</dd></div>
    <div><dt>shares offered</dt><dd>{% if sized %}{{ n(offered_ref, "m") }}{% else %}{{ n("offering.shares_total", "m") }}{% endif %}</dd></div>
    <div><dt>raises</dt><dd>{% if sized %}{{ n(raised_ref) }}{% elif priced %}{{ n("offering.size.final") }}{% else %}{{ n("offering.size.low") }}<span class="to">–</span>{{ n("offering.size.high") }}{% endif %}</dd></div>
    <div><dt>value</dt><dd>{% if priced %}{{ n("value.mcap_out.final") }}{% else %}{{ n("value.mcap_out.low") }}<span class="to">–</span>{{ n("value.mcap_out.high") }}{% endif %}</dd></div>
    <div><dt>prices</dt><dd>{{ n("press.cnbc.pricing_date", "short") }}</dd></div>
    <div><dt>trades</dt><dd>{{ n("press.cnbc.trading_date", "short") }}</dd></div>
  </dl>
  {% if reported %}<p class="glance-note">Press figures; values below use the {{ n("offering.shares_total", "m") }} filed shares until the final prospectus.</p>{% endif %}
</section>

<nav class="keys" aria-label="Panels">
  {% if quote %}<a href="#market" class="desk"><kbd aria-hidden="true">m</kbd>market</a>{% endif %}
  <a href="#value"><kbd aria-hidden="true">v</kbd>value</a>
  <a href="#ev"><kbd aria-hidden="true">e</kbd>ev<span class="wide"> bridge</span></a>
  <a href="#shares"><kbd aria-hidden="true">s</kbd>shares</a>
  <a href="#unlock"><kbd aria-hidden="true">u</kbd>unlock</a>
  <a href="#control"><kbd aria-hidden="true">k</kbd>control</a>
  <a href="#contracts"><kbd aria-hidden="true">c</kbd>contracts</a>
  <a href="#growth"><kbd aria-hidden="true">g</kbd>growth</a>
  <a href="#losses"><kbd aria-hidden="true">l</kbd>losses</a>
  <a href="#timeline"><kbd aria-hidden="true">t</kbd>timeline</a>
  <a href="#visits"><kbd aria-hidden="true">w</kbd>visits</a>
  {% if steps %}<a href="#history"><kbd aria-hidden="true">h</kbd>history</a>{% endif %}
  <button type="button" class="help-key" popovertarget="help" aria-label="Help"><kbd aria-hidden="true">?</kbd><span class="wide">help</span></button>
</nav>
<div class="tools">
  <p class="keys-hint">Press a letter to jump to a panel · <kbd>?</kbd> all keys · select any number to see its source</p>
  <p class="fold-all" hidden>tables: <button type="button" data-folds="open">open all</button> · <button type="button" data-folds="close">fold all</button></p>
</div>

<main id="main">

<section class="status overview" aria-labelledby="overview-h">
  <h2 id="overview-h" class="ov-head"><span class="ov-tag">OVERVIEW</span> <span class="ov-phase">{{ phase }}</span>{% if not priced %} <span class="ov-days" data-until="{{ pricing_day }}" hidden></span>{% endif %}</h2>
  <div class="ov-grid">
  <div class="ov-main">
  {% set stages = moments[-4:] %}
  <ol class="stages" aria-label="Stage of the IPO">
    {% for m in stages %}
    <li class="st-{{ m.state }}"><span class="dot" aria-hidden="true"></span><span class="st-what">{% if m.ref == "unlock.01" %}unlock{% elif m.state == "done" and loop.first %}filed{% elif m.what == "first trade" %}trading{% else %}{{ L(m.what) }}{% endif %}</span>{% if m.ref.startswith("press.") and m.state != "done" %}<span class="st-when wide"> ~{{ n(m.ref, "short") }}</span>{% elif m.ref == "unlock.01" %}<span class="st-when wide"> day {{ L("1") }}</span>{% endif %}<span class="vh"> ({{ "done" if m.state == "done" else ("next" if m.state == "next" else "to come") }})</span></li>
    {% endfor %}
  </ol>
  <dl>
    <div><dt>source</dt><dd>SEC {{ L(document.title) }} · {{ filed_word(document) }} {{ n("doc.filed_date") }}{% if steps %} · <a href="#history">what changed</a>{% endif %}<span class="wide"> · figures as of {{ L("Sep 30, 2026") }} unless noted</span></dd></div>
    <div class="dup"><dt>offer</dt><dd>{% if ranged %}{% if priced %}priced at {{ n(price_ref) }} · {% endif %}{{ n("offering.shares_total", "m") }} shares{% if priced %}, marketed{% endif %} at {{ n("offering.price_low") }} to {{ n("offering.price_high") }} · raises {{ n("offering.size.low") }} to {{ n("offering.size.high") }}{% else %}{{ n("offering.shares_total", "m") }} shares at {{ n(price_ref) }} · raises {{ n("offering.size.final") }}{% endif %}<span class="wide"> · plus a {{ n("offering.private_placement") }} private placement</span></dd></div>
    <div class="dup"><dt>listing</dt><dd>{{ n("offering.exchange") }}, symbol {{ n("offering.symbol") }} ({{ n("offering.listing") }}) · prices {{ n("press.cnbc.pricing_date", "short") }} · trades {{ n("press.cnbc.trading_date", "short") }} (reported)</dd></div>
    <div><dt>filings</dt><dd>
      {%- if not filings -%}
        not watched · this page does not check the SEC for new filings
      {%- elif not filings.filings -%}
        <span class="wait">source unavailable</span> · the SEC's list of filings could not be read<span class="wide"> · {{ L(filings.detail) }}</span>
      {%- elif newer -%}
        <span class="live">new filing</span> · <a href="{{ newer.url }}" rel="noopener" data-label>{{ newer.name }}</a>{% if newer.meaning %}, {{ L(newer.meaning) }}{% endif %} · filed {{ L(day(newer.filed)) }} · {% if price_used and filings.prospectus == newer %}its price is used on this page<span class="wide">; the other figures still come from {{ L(document.title) }}</span>{% else %}its figures are not read by this page yet{% endif %}
      {%- else -%}
        watching the SEC · latest: <a href="{{ listed[0].first.url }}" rel="noopener" data-label>{{ listed[0].first.name }}</a><span class="wide"> · filed {{ L(day(listed[0].first.filed)) }} · <a href="#filings">recent filings</a></span>
      {%- endif -%}
      {%- if filings and filings.filings and filings.state == "unavailable" %} · <span class="wait">the last check failed</span>{% endif -%}
      {%- if filings %} · <span class="chk">checked {{ L(clock(filings.checked)) }}</span>{% endif -%}
    </dd></div>
    <div><dt>market</dt><dd>
      {%- if not market -%}
        no market source connected
      {%- elif market.state == "awaiting" -%}
        <span class="wait">awaiting listing</span> · no share price exists yet<span class="wide"> · {{ L(market.detail) }}</span>
      {%- elif not quote -%}
        <span class="wait">source unavailable</span> · no price is shown<span class="wide"> · {{ market.source }}: {{ L(market.detail) }}</span>
      {%- else -%}
        {% if market.state == "trading" %}<span class="live">trading</span>{% elif market.state == "closed" %}market closed{% if quote.outside %} · traded {{ quote.outside }}{% endif %}{% else %}<span class="wait">source unavailable</span>, last quote{% endif %} · {{ n("market.price") }} · {{ n("market.time") }} · {{ market.source }}, delayed, unofficial
      {%- endif -%}
      {%- if market %} · <span class="chk">checked {{ L(clock(market.checked)) }}</span>{% endif -%}
    </dd></div>
    <div><dt>next</dt><dd>
      {%- if quote -%}
        the share price is checked every few minutes; the lock-up steps are in <a href="#unlock">unlock</a>
      {%- elif priced -%}
        first trade reported for {{ n("press.cnbc.trading_date", "short") }}<span class="wide">; the market panel appears by itself with the first quote</span>
      {%- else -%}
        pricing reported for {{ n("press.cnbc.pricing_date", "short") }}<span class="wide">; the final prospectus is due within two business days, and</span><span class="narrow">;</span> this page takes the final price by itself
      {%- endif -%}
    </dd></div>
  </dl>
  </div>
  <figure class="chart ov-ring">
    <figcaption>Who holds the shares after the IPO</figcaption>
    {{ chart("holders.after") }}
    <p class="ov-ring-keys"><span class="sw fg-base" aria-hidden="true"></span>existing holders <span class="sw fg-pos" aria-hidden="true"></span>IPO buyers <span class="sw fg-far" aria-hidden="true"></span>private placement · <a href="#shares">shares</a></p>
  </figure>
  </div>
  <ul class="legend">
    <li>{{ tag("FILED") }} <span>copied from the SEC filing</span></li>
    <li>{{ tag("CALC") }} <span>our arithmetic, inputs shown</span></li>
    <li>{{ tag("PRESS") }} <span>reported by news media</span></li>
    {% if quote %}<li>{{ tag("MARKET") }} <span>a delayed, unofficial quote</span></li>{% endif %}
    <li class="hint">Select a number or a chart to see where it comes from.</li>
  </ul>
</section>

{% if quote %}
<section class="panel" id="market" tabindex="-1" aria-labelledby="market-h">
  <h2 id="market-h"><kbd aria-hidden="true">m</kbd> MARKET <span class="q">What is the market paying now?</span></h2>
  <p class="lede">{{ tag("MARKET") }} {{ market.source }} · delayed, unofficial · last trade {{ n("market.time") }}{% if quote.outside %}, {{ quote.outside }}{% endif %}{% if market.state == "closed" %} · market closed{% elif market.state == "unavailable" %} · <span class="wait">the source is unavailable: this is the last quote it gave</span>{% endif %}</p>

  <div class="tiles">
    <div class="tile tile-key">
      <h3>Last price{% if quote.outside %}, {{ quote.outside }}{% endif %}</h3>
      <p class="big">{{ n("market.price") }}</p>
      <p class="sub">{{ n("market.vs_ipo", "signed", plus=true) }} against {% if priced %}the IPO price of {{ n(price_ref) }}{% else %}{{ n(price_ref) }}, the middle of the IPO range{% endif %}</p>
    </div>
    <div class="tile">
      <h3>Value at that price</h3>
      <p class="big">{{ n("market.mcap_out") }} <span class="to">to</span> {{ n("market.equity_diluted") }}</p>
      <p class="sub">shares outstanding, then diluted</p>
    </div>
    <div class="tile">
      <h3>Enterprise value at that price</h3>
      <p class="big">{{ n("market.enterprise_value") }}</p>
      <p class="sub">{{ n("market.multiple.run_rate") }} Run-Rate Revenue</p>
    </div>
  </div>

  <div class="split">
    {% if quote.line|length > 1 %}
    <figure class="chart">
      <figcaption>Price through the day</figcaption>
      {{ chart("market.day") }}
    </figure>
    {% endif %}
    <div>
      <table class="lines">
        <caption>The day so far</caption>
        <tbody>
          <tr><th scope="row">Last price{% if quote.outside %}, {{ quote.outside }}{% endif %}</th><td>{{ n("market.price") }}</td></tr>
          {% if quote.close is not none %}<tr><th scope="row">Close of regular hours, {{ L(quote.close_day) }}</th><td>{{ n("market.close") }}</td></tr>{% endif %}
          {% if quote.day_low is not none and quote.day_high is not none %}<tr><th scope="row">Range in regular hours</th><td>{{ n("market.day_low") }} <span class="to">to</span> {{ n("market.day_high") }}</td></tr>{% endif %}
          {% if quote.volume is not none %}<tr><th scope="row">Shares traded</th><td>{{ n("market.volume") }}</td></tr>{% endif %}
          {% if quote.previous_close is not none %}<tr><th scope="row">Previous close</th><td>{{ n("market.previous_close") }}</td></tr>{% endif %}
          <tr><th scope="row">{% if priced %}IPO price{% else %}Middle of the IPO range{% endif %}</th><td>{{ n(price_ref) }}</td></tr>
        </tbody>
      </table>
      <p class="aside">The share counts and the cash behind these values come from the filing; only the price moves. {% if quote.day_high is not none and quote.line|length > 1 %}The range counts regular trading hours only; the line can also show trades made before the open and after the close. {% endif %}{% if not priced %}The final IPO price is not recorded here yet, so the comparison uses the middle of the filed range.{% endif %}</p>
    </div>
  </div>
</section>
{% endif %}

<section class="panel" id="value" tabindex="-1" aria-labelledby="value-h">
  <h2 id="value-h"><kbd aria-hidden="true">v</kbd> VALUE <span class="q">What is Anthropic worth at the IPO price?</span></h2>

  <div class="tiles">
    <div class="tile">
      <h3>Shares that exist after the IPO</h3>
      {% if priced %}
      <p class="big">{{ n("value.mcap_out.final") }}</p>
      <p class="sub">{{ n("value.shares_out.final") }} shares × the IPO price of {{ n(price_ref) }}</p>
      {% else %}
      <p class="big">{{ n("value.mcap_out.low") }} <span class="to">to</span> {{ n("value.mcap_out.high") }}</p>
      <p class="sub">{{ n("value.shares_out.mid") }} shares × the price range</p>
      {% endif %}
    </div>
    <div class="tile">
      <h3>Diluted: plus shares already owed or granted</h3>
      {% if priced %}
      <p class="big">{{ n("value.equity_diluted.final") }}</p>
      <p class="sub">{{ n("value.shares_diluted.final") }} shares × the IPO price</p>
      {% else %}
      <p class="big">{{ n("value.equity_diluted.low") }} <span class="to">to</span> {{ n("value.equity_diluted.high") }}</p>
      <p class="sub">{{ n("value.shares_diluted." ~ base_pt) }} shares × the price range</p>
      {% endif %}
    </div>
    <div class="tile tile-key">
      <h3>Enterprise value at {{ n(price_ref) }}</h3>
      <p class="big">{{ n("ev.enterprise_value." ~ at) }}</p>
      <p class="sub">the business itself, net of its cash</p>
    </div>
  </div>

  {% if ranged %}
  <div class="split">
    <figure class="chart">
      <figcaption>Three share counts, across the price range</figcaption>
      {{ chart("value.ranges") }}
    </figure>
    <div>
      <table class="grid">
        <caption>Implied value by IPO price</caption>
        <thead>
          <tr><th scope="col">Counting</th><th scope="col">{{ n("offering.price_low") }}</th><th scope="col">{{ n("offering.price_mid") }}</th><th scope="col">{{ n("offering.price_high") }}</th><th scope="col">Shares</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">Outstanding</th><td>{{ n("value.mcap_out.low") }}</td><td>{{ n("value.mcap_out.mid") }}</td><td>{{ n("value.mcap_out.high") }}</td><td>{{ n("value.shares_out.mid") }}</td></tr>
          <tr><th scope="row">Diluted</th><td>{{ n("value.equity_diluted.low") }}</td><td>{{ n("value.equity_diluted.mid") }}</td><td>{{ n("value.equity_diluted.high") }}</td><td>{{ n("value.shares_diluted." ~ base_pt) }}</td></tr>
          <tr class="muted"><th scope="row">Press basis</th><td>{{ n("value.headline.low") }}</td><td>{{ n("value.headline.mid") }}</td><td>{{ n("value.headline.high") }}</td><td>{{ n("value.headline_shares") }}</td></tr>
        </tbody>
      </table>
      <p class="aside">Outstanding counts the shares that exist after the IPO. Diluted adds the shares already owed or granted. The press basis is the count that reproduces the largest headline.</p>
    </div>
  </div>
  {% endif %}

  <div class="cols">
    <div>
      <h3>How the share count builds up</h3>
      <table class="lines bars">
        <tbody>
          <tr><th scope="row">Outstanding after the IPO</th><td>{{ n("shares.total_after", "m") }}</td><td class="barcell">{{ bar(n.share("shares.total_after", "value.shares_diluted." ~ base_pt), "fg-base") }}</td></tr>
          <tr><th scope="row"><span class="op">+</span> owed to Amazon on its notes</th><td>{{ n("notes.shares_remaining", "m") }}</td><td class="barcell">{{ bar(n.share("notes.shares_remaining", "value.shares_diluted." ~ base_pt)) }}</td></tr>
          <tr><th scope="row"><span class="op">+</span> employee stock options</th><td>{{ n("shares.options", "m") }}</td><td class="barcell">{{ bar(n.share("shares.options", "value.shares_diluted." ~ base_pt)) }}</td></tr>
          <tr><th scope="row"><span class="op">+</span> employee RSUs not yet vested</th><td>{{ n("value.rsu_shares", "m") }}</td><td class="barcell">{{ bar(n.share("value.rsu_shares", "value.shares_diluted." ~ base_pt)) }}</td></tr>
          <tr><th scope="row"><span class="op">+</span> issued since {{ L("Sep 30") }}</th><td>{{ n("value.issued_since_shares", "m") }}</td><td class="barcell">{{ bar(n.share("value.issued_since_shares", "value.shares_diluted." ~ base_pt)) }}</td></tr>
          <tr class="sum"><th scope="row"><span class="op">=</span> diluted share count</th><td>{{ n("value.shares_diluted." ~ base_pt, "m") }}</td><td class="barcell">{{ bar(100, "fg-sum") }}</td></tr>
          <tr class="muted"><th scope="row">Not counted: reserved for grants</th><td>{{ n("value.reserve_shares", "m") }}</td><td class="barcell">{{ bar(n.share("value.reserve_shares", "value.shares_diluted." ~ base_pt), "fg-muted") }}</td></tr>
        </tbody>
      </table>
    </div>
    <div>
      <h3>Why headlines disagree</h3>
      <ul class="notes">
        {% if ranged %}<li>Reuters put the value near {{ n("press.reuters.outstanding_high") }} at the top of the range. That counts only the shares outstanding: our {{ n("value.mcap_out.high") }}.</li>
        <li>CNBC reported up to {{ n("press.cnbc.fully_diluted_high", "b1") }} “fully diluted”. We reproduce it <span class="nw">({{ n("value.headline.high", "b1") }})</span> only by adding the {{ n("value.reserve_shares") }} shares reserved for grants that do not exist yet, and by leaving out the {{ n("notes.shares_remaining") }} shares still owed to Amazon.</li>{% else %}<li>On the basis the press used before pricing (shares reserved for future grants counted, the shares owed to Amazon left out), the value at the IPO price is {{ n("value.headline.final", "b1") }}.</li>{% endif %}
        <li>Same filing, three share counts. Our diluted figure counts what is already owed or granted, and nothing else.</li>
      </ul>
    </div>
  </div>
</section>

<div class="pair">
<section class="panel" id="ev" tabindex="-1" aria-labelledby="ev-h">
  <h2 id="ev-h"><kbd aria-hidden="true">e</kbd> EV BRIDGE <span class="q">What does that price really buy?</span></h2>
  <p class="lede">Enterprise value is the price of the business itself: every share, minus the cash that comes with the company.</p>
  <table class="lines bars bridge">
    <caption>{% if priced %}At the IPO price of {{ n(price_ref) }}{% else %}At the assumed {{ n(price_ref) }} price{% endif %}</caption>
    <tbody>
      <tr><th scope="row">Diluted value</th><td>{{ n("value.equity_diluted." ~ at, "b1") }}</td><td class="barcell">{{ chart.step("value.equity_diluted." ~ at) }}</td></tr>
      <tr><th scope="row"><span class="op">−</span> cash after the offering</th><td>{{ n("ev.cash_after." ~ at, "b1") }}</td><td class="barcell">{{ chart.step("ev.cash_after." ~ at) }}</td></tr>
      <tr><th scope="row"><span class="op">−</span> cash from option exercises</th><td>{{ n("ev.option_proceeds", "b1") }}</td><td class="barcell">{{ chart.step("ev.option_proceeds") }}</td></tr>
      <tr><th scope="row"><span class="op">+</span> borrowings drawn</th><td>{{ n("debt.credit_facility_drawn", "b1") }}</td><td class="barcell">{{ chart.step("debt.credit_facility_drawn") }}</td></tr>
      <tr class="sum"><th scope="row"><span class="op">=</span> enterprise value</th><td>{{ n("ev.enterprise_value." ~ at, "b1") }}</td><td class="barcell">{{ chart.step("ev.enterprise_value." ~ at) }}</td></tr>
    </tbody>
  </table>
  {% if ranged %}
  <figure class="chart chart-gap">
    <figcaption>Before and after the cash, across the price range</figcaption>
    {{ chart("ev.ranges") }}
  </figure>
  {% endif %}
  <p class="aside">{% if ranged %}Across the range: {{ n("ev.enterprise_value.low") }} at {{ n("offering.price_low") }}, {% if priced %}{{ n("ev.enterprise_value.mid") }} at {{ n("offering.price_mid") }}, {% endif %}{{ n("ev.enterprise_value.high") }} at {{ n("offering.price_high") }}. {% endif %}The notes still owed to Amazon (carried at {{ n("capitalization.convertible_notes.as_adjusted", "b1") }}) are counted as shares above, so they are not added again as debt.</p>

  <h3>The cash that comes with the company{% if priced and ranged %}, as filed at {{ n("offering.price_mid") }}{% endif %}</h3>
  <table class="lines">
    <tbody>
      <tr><th scope="row">Cash and short-term investments today</th><td>{{ n("balance.cash.actual", "b1") }}</td></tr>
      <tr><th scope="row"><span class="op">+</span> net proceeds of the IPO and private placement</th><td>{{ n("offering.net_proceeds_mid", "b1") }}</td></tr>
      <tr><th scope="row"><span class="op">−</span> taxes paid on employee RSUs at the offering</th><td>{{ n("ev.rsu_tax_paid", "b1") }}</td></tr>
      <tr class="sum"><th scope="row"><span class="op">=</span> cash after the offering</th><td>{{ n("ev.cash_after." ~ base_pt, "b1") }}</td></tr>
    </tbody>
  </table>

  <h3>That price, measured against revenue</h3>
  <table class="lines bars bars-wide">
    <thead>
      <tr><th scope="col">Revenue measure</th><th scope="col">Revenue</th><th scope="col">Price ÷ revenue</th><th scope="col" class="barcol"><span class="vh">Price ÷ revenue, drawn</span></th></tr>
    </thead>
    <tbody>
      <tr><th scope="row">Run-Rate Revenue, {{ L("Oct 31") }}</th><td>{{ n("metrics.run_rate_oct31") }}</td><td>{{ n("ev.multiple.run_rate") }}</td><td class="barcell">{{ bar(n.share("ev.multiple.run_rate", "ev.multiple.ttm"), "fg-s1") }}</td></tr>
      <tr><th scope="row">Latest quarter × four</th><td>{{ n("growth.q3_annualized") }}</td><td>{{ n("ev.multiple.q3_annualized") }}</td><td class="barcell">{{ bar(n.share("ev.multiple.q3_annualized", "ev.multiple.ttm"), "fg-s1") }}</td></tr>
      <tr><th scope="row">Last twelve months</th><td>{{ n("growth.ttm_revenue") }}</td><td>{{ n("ev.multiple.ttm") }}</td><td class="barcell">{{ bar(100, "fg-s1") }}</td></tr>
    </tbody>
  </table>
  <p class="aside">The faster revenue grows, the further apart these three measures sit. Which one fits depends on whether the growth lasts.</p>
</section>

<section class="panel" id="shares" tabindex="-1" aria-labelledby="shares-h">
  <h2 id="shares-h"><kbd aria-hidden="true">s</kbd> SHARES <span class="q">Where do the offered shares go?</span></h2>
  <div class="stacked">
    <figure class="chart">
      <figcaption>Shares in the deal, by where they come from</figcaption>
      {{ chart("deal.shares") }}
    </figure>
    <details class="fold" open>
    <summary>The same, in figures</summary>
    <table class="lines bars">
      <caption class="vh">Shares in the deal</caption>
      <tbody>
        <tr><th scope="row">New shares sold by the company</th><td>{{ n("offering.shares_company", "m") }}</td><td class="barcell">{{ bar(n.share("offering.shares_company", "deal.shares_all"), "fg-base") }}</td></tr>
        <tr><th scope="row">Sold by existing stockholders</th><td>{{ n("offering.shares_selling", "m") }}</td><td class="barcell">{{ bar(n.share("offering.shares_selling", "deal.shares_all"), "fg-base") }}</td></tr>
        <tr class="sum"><th scope="row"><span class="op">=</span> the IPO, taken by the underwriters</th><td>{{ n("underwriting.total", "m") }}</td><td class="barcell"></td></tr>
        <tr><th scope="row"><span class="op">+</span> underwriters' option, if demand allows</th><td>{{ n("offering.greenshoe", "m") }}</td><td class="barcell">{{ bar(n.share("offering.greenshoe", "deal.shares_all"), "fg-mid") }}</td></tr>
        <tr><th scope="row"><span class="op">+</span> private placement, at the middle of the range</th><td>{{ n("offering.private_placement_shares_mid", "m") }}</td><td class="barcell">{{ bar(n.share("offering.private_placement_shares_mid", "deal.shares_all"), "fg-far") }}</td></tr>
        <tr class="sum"><th scope="row"><span class="op">=</span> all shares in the deal</th><td>{{ n("deal.shares_all", "m") }}</td><td class="barcell"></td></tr>
      </tbody>
    </table>
    </details>
  </div>
  <p class="aside">The money for the new shares goes to the company; the money for the shares of existing stockholders goes to them. The private placement is sold outside the IPO, at the IPO price, to {{ n("placement.buyers") }}, for {{ n("offering.private_placement") }}.</p>

  <h3>Who holds the shares after the IPO</h3>
  {{ stack([(n.share("holders.existing_after", "shares.total_after"), "fg-base"), (n.share("holders.new_after", "shares.total_after"), "fg-pos"), (n.share("offering.private_placement_shares_mid", "shares.total_after"), "fg-far")]) }}
  <table class="lines">
    <tbody>
      <tr><th scope="row"><span class="sw fg-base" aria-hidden="true"></span>Existing stockholders</th><td>{{ n("holders.existing_after") }} · {{ n("holders.existing_after_pct", "one") }}</td></tr>
      <tr><th scope="row"><span class="sw fg-pos" aria-hidden="true"></span>Buyers in the IPO</th><td>{{ n("holders.new_after") }} · {{ n("holders.new_after_pct", "one") }}</td></tr>
      <tr><th scope="row"><span class="sw fg-far" aria-hidden="true"></span>Private placement buyers</th><td>{{ n("offering.private_placement_shares_mid") }} · {{ n("holders.placement_after_pct", "one") }}</td></tr>
      <tr class="sum"><th scope="row"><span class="op">=</span> all shares after the IPO</th><td>{{ n("shares.total_after") }}</td></tr>
    </tbody>
  </table>

  <h3>The banks</h3>
  <p class="banks">{% for bank in banks %}<span class="bank">{{ bank }}</span>{% endfor %}</p>
  <p class="aside">The underwriters take {{ n("underwriting.total", "m") }} shares together. How many each bank takes is left blank in this filing; it is filled in the final prospectus. Directors and entities linked to them have said they may buy up to {{ n("offering.insider_interest", "m") }} of shares in the IPO; that is not a commitment.</p>
</section>

<section class="panel" id="control" tabindex="-1" aria-labelledby="control-h">
  <h2 id="control-h"><kbd aria-hidden="true">k</kbd> CONTROL <span class="q">Who controls the company?</span></h2>
  <h3>Votes on matters put to stockholders</h3>
  <div class="split split-tight split-ring">
    <figure class="chart">
      {{ chart("control.votes") }}
    </figure>
  <table class="lines">
    <tbody>
      <tr><th scope="row"><span class="sw fg-neg" aria-hidden="true"></span>Class F, one share held by the co-founders' company</th><td>{{ n("control.class_f_pct", "one") }}</td></tr>
      <tr><th scope="row"><span class="sw fg-blank" aria-hidden="true"></span>Class A, all shares together, {{ n("control.class_a") }} vote each</th><td>{{ n("control.class_a_pct", "one") }}</td></tr>
      <tr><th scope="row"><span class="sw fg-base" aria-hidden="true"></span>of which other holders</th><td>{{ n("control.class_a_other_pct", "one") }}</td></tr>
      <tr><th scope="row"><span class="sw fg-pos" aria-hidden="true"></span>of which the shares sold in the IPO</th><td>{{ n("control.ipo_votes_pct", "one") }}</td></tr>
    </tbody>
  </table>
  </div>
  <h3>The other classes</h3>
  <table class="lines words">
    <tbody>
      <tr><th scope="row">Class T, held by the Long-Term Benefit Trust</th><td>elects {{ n("control.class_t") }} of the board</td></tr>
      <tr><th scope="row">Class N, strategic partners and the private placement</th><td>{{ n("control.class_n") }}</td></tr>
      <tr><th scope="row">Class E, employees</th><td>votes {{ n("control.class_e") }}</td></tr>
    </tbody>
  </table>
  <p class="aside">Shares bought in the IPO are Class A. The Class F share's voting power is fixed by the company's charter, and the trust elects a majority of the board through Class T, apart from these votes.</p>
</section>

<section class="panel" id="contracts" tabindex="-1" aria-labelledby="contracts-h">
  <h2 id="contracts-h"><kbd aria-hidden="true">c</kbd> CONTRACTS <span class="q">What is signed, in both directions?</span></h2>
  <table class="lines bars">
    <tbody>
      <tr><th scope="row">Customers have committed to pay Anthropic</th><td>{{ n("rpo.total", "b1") }}</td><td class="barcell">{{ bar(n.share("rpo.total", "commit.total"), "fg-pos") }}</td></tr>
      <tr><th scope="row">Anthropic has committed to pay suppliers</th><td>{{ n("commit.total", "b1") }}</td><td class="barcell">{{ bar(100, "fg-neg") }}</td></tr>
    </tbody>
  </table>
  <p class="aside">That is {{ n("contracts.owed_vs_signed") }} more committed out than in, almost all for compute and infrastructure. Run-Rate Revenue is {{ n("metrics.run_rate_oct31") }}, so most sales are billed on usage, without a long-term commitment.</p>

  <h3>When the spending falls due</h3>
  {{ stack([(n.share("commit.next_12m", "commit.total"), "fg-neg"), (n.share("contracts.rest_before_2031", "commit.total"), "fg-mid"), (n.share("contracts.after_2030", "commit.total"), "fg-far")]) }}
  <table class="lines">
    <tbody>
      <tr><th scope="row"><span class="sw fg-neg" aria-hidden="true"></span>Next twelve months</th><td>{{ n("commit.next_12m", "b1") }}</td></tr>
      <tr><th scope="row"><span class="sw fg-mid" aria-hidden="true"></span>Later, before {{ L("2031") }}</th><td>{{ n("contracts.rest_before_2031", "b1") }}</td></tr>
      <tr><th scope="row"><span class="sw fg-far" aria-hidden="true"></span>{{ L("2031 to 2045") }}</th><td>{{ n("contracts.after_2030", "b1") }}</td></tr>
    </tbody>
  </table>

  <h3>Payments already running, by year due</h3>
  <div class="split split-tight">
    <figure class="chart">
      {{ chart("contracts.due_by_year") }}
    </figure>
    <details class="fold" open>
    <summary>The same, in figures</summary>
    <table class="lines due">
      <caption class="vh">Payments already running, by year due</caption>
      <tbody>
        <tr><th scope="row">{{ L("2026, Oct to Dec") }}</th><td>{{ n("obligations.total.2026", "b1") }}</td></tr>
        <tr><th scope="row">{{ L("2027") }}</th><td>{{ n("obligations.total.2027", "b1") }}</td></tr>
        <tr><th scope="row">{{ L("2028") }}</th><td>{{ n("obligations.total.2028", "b1") }}</td></tr>
        <tr><th scope="row">{{ L("2029") }}</th><td>{{ n("obligations.total.2029", "b1") }}</td></tr>
        <tr><th scope="row">{{ L("2030") }}</th><td>{{ n("obligations.total.2030", "b1") }}</td></tr>
        <tr><th scope="row">Later years</th><td>{{ n("obligations.total.thereafter", "b1") }}</td></tr>
        <tr class="sum"><th scope="row"><span class="op">=</span> already running</th><td>{{ n("obligations.total.total", "b1") }}</td></tr>
      </tbody>
    </table>
    </details>
  </div>
  <p class="aside">The filing gives a schedule by year for the payments already running. The last column adds up every later year, so it is not comparable with a single year.</p>

  <h3>What it is made of</h3>
  <table class="lines">
    <tbody>
      <tr><th scope="row">Leases signed, not yet started</th><td>{{ n("commit.leases_not_commenced", "b1") }}</td></tr>
      <tr><th scope="row">Fixed payments already running</th><td>{{ n("obligations.total.total", "b1") }}</td></tr>
      <tr><th scope="row">Signed after {{ L("Sep 30") }}</th><td>{{ n("contracts.signed_after_sep30", "b1") }}</td></tr>
      <tr><th scope="row">Short-term commitments</th><td>{{ n("commit.short_term", "b1") }}</td></tr>
      <tr class="muted"><th scope="row">Of the total, still cancellable or conditional</th><td>{{ n("commit.conditional", "b1") }}</td></tr>
    </tbody>
  </table>
  <p class="aside">Cash after the offering covers the next twelve months {{ n("contracts.cash_cover_12m") }}. The whole commitment equals {{ n("contracts.years_of_run_rate") }} years of today's Run-Rate Revenue.</p>
</section>

<section class="panel span" id="unlock" tabindex="-1" aria-labelledby="unlock-h">
  <h2 id="unlock-h"><kbd aria-hidden="true">u</kbd> UNLOCK <span class="q">When may existing holders sell?</span></h2>
  <p class="lede">Most shares that exist before the IPO cannot be sold at once. The filing gives a schedule: at each step, up to this many shares become available for sale.</p>
  <div class="split">
    <figure class="chart">
      <figcaption>Shares that may be sold, step by step</figcaption>
      {{ chart("unlock.steps") }}
    </figure>
    <details class="fold" open>
    <summary>The filing's table</summary>
    <table class="lines unlock">
      <caption class="vh">Shares eligible for sale after the IPO</caption>
      <tbody>
        {% for key, (short, event) in unlock %}
        <tr><th scope="row"><span class="step" data-label>{{ event }} · {{ short }}</span> {{ n(key ~ ".when") }}</th><td>{{ n(key, "m") }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    </details>
  </div>
  <p class="aside">{% if ranged %}Days count from the date of the final prospectus, not known yet, or from a results release.{% else %}Days count from the date of the final prospectus ({{ n("doc.filed_date") }}), or from a results release; the prospectus dates the first steps itself.{% endif %} <span data-label>R</span> is the release day as the filing defines it; <span data-label>R*</span> is the earlier of a release and a day counted from the prospectus. Each step is a maximum, and the filing does not say the steps add up, so no total is given here. The filing gives each step for Class A and Class N shares and their total; the page shows the total (Class N shares become Class A when sold).</p>
</section>
</div>

<section class="panel" id="growth" tabindex="-1" aria-labelledby="growth-h">
  <h2 id="growth-h"><kbd aria-hidden="true">g</kbd> GROWTH <span class="q">How fast is it growing, and what does the growth cost?</span></h2>

  <div class="tiles">
    <div class="tile">
      <h3>Run-Rate Revenue</h3>
      <p class="big">{{ n("growth.run_rate_sep30") }} <span class="to">→</span> {{ n("metrics.run_rate_oct31") }}</p>
      <p class="sub">{{ L("Sep 30") }} to {{ L("Oct 31, 2026") }}</p>
    </div>
    <div class="tile">
      <h3>Net Revenue Retention</h3>
      <p class="big">{{ n("metrics.net_revenue_retention") }}</p>
      <p class="sub">what last year's customers spend now, versus then; consumer plans excluded</p>
    </div>
    <div class="tile">
      <h3>Customers paying six figures a year</h3>
      <p class="big">{{ n("metrics.customers_100k_2025") }} <span class="to">→</span> {{ n("metrics.customers_100k_2026") }}</p>
      <p class="sub">{{ L("Sep 30, 2025") }} to {{ L("Sep 30, 2026") }}</p>
    </div>
  </div>

  <div class="charts">
    <figure class="chart">
      <figcaption>Revenue by quarter</figcaption>
      {{ chart("growth.revenue") }}
    </figure>
    <figure class="chart">
      <figcaption>Growth over the prior quarter</figcaption>
      {{ chart("growth.qoq") }}
    </figure>
    <figure class="chart">
      <figcaption><span class="key s1" aria-hidden="true"></span>Revenue against <span class="key s2" aria-hidden="true"></span>compute cost</figcaption>
      {{ chart("growth.revenue_vs_compute") }}
    </figure>
    <figure class="chart">
      <figcaption>Operating margin</figcaption>
      {{ chart("growth.margin") }}
    </figure>
  </div>

  <div class="cols cols-even cols-end">
    <details class="fold" open>
    <summary>Revenue and growth, in millions of dollars</summary>
    <table class="grid quarters">
      <caption class="vh">Revenue and growth, in millions of dollars</caption>
      <thead>
        <tr>
          <th scope="col">Quarter</th>
          <th scope="col">Revenue</th>
          <th scope="col">vs prior quarter</th>
          <th scope="col">vs year before</th>
        </tr>
      </thead>
      <tbody>
      {% for key, name in quarters %}
        <tr>
          <th scope="row">{{ L(name) }}</th>
          <td>{{ n("q.revenue." ~ key, "t") }}</td>
          <td>{% if loop.index0 >= 1 %}{{ n("growth.qoq." ~ key, "signed", plus=true) }}{% else %}<span class="na">n/a</span>{% endif %}</td>
          <td>{% if loop.index0 >= 4 %}{{ n("growth.yoy." ~ key, "signed", plus=true) }}{% else %}<span class="na">n/a</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </details>
    <details class="fold" open>
    <summary>Cost and margin, in millions of dollars</summary>
    <table class="grid quarters">
      <caption class="vh">Cost and margin, in millions of dollars</caption>
      <thead>
        <tr>
          <th scope="col">Quarter</th>
          <th scope="col">Compute cost</th>
          <th scope="col">Revenue per compute dollar</th>
          <th scope="col">Operating result</th>
          <th scope="col">Margin</th>
        </tr>
      </thead>
      <tbody>
      {% for key, name in quarters %}
        <tr>
          <th scope="row">{{ L(name) }}</th>
          <td>{{ n("q.compute." ~ key, "t") }}</td>
          <td>{{ n("growth.revenue_per_compute." ~ key, "usd") }}</td>
          <td>{{ n("q.operating_income." ~ key, "t", plus=true) }}</td>
          <td>{{ n("growth.operating_margin." ~ key, "signed", plus=true) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </details>
  </div>
  <p class="aside">Full years: {{ n("is.revenue.fy2023", "m") }} in {{ L("2023") }}, {{ n("is.revenue.fy2024", "m") }} in {{ L("2024") }} <span class="nw">({{ n("growth.annual.fy2024", "signed", plus=true) }})</span>, {{ n("is.revenue.fy2025", "m") }} in {{ L("2025") }} <span class="nw">({{ n("growth.annual.fy2025", "signed", plus=true) }})</span>. First nine months of {{ L("2026") }}: {{ n("is.revenue.9m2026", "m") }} <span class="nw">({{ n("growth.annual.9m2026", "signed", plus=true) }})</span>.</p>
  <p class="aside">Growth over the prior quarter slowed from {{ n("growth.qoq.2026q2", "signed", plus=true) }} to {{ n("growth.qoq.2026q3", "signed", plus=true) }}, and revenue per compute dollar slipped from {{ n("growth.revenue_per_compute.2026q2", "usd") }} to {{ n("growth.revenue_per_compute.2026q3", "usd") }}.</p>
</section>

<section class="panel" id="losses" tabindex="-1" aria-labelledby="losses-h">
  <h2 id="losses-h"><kbd aria-hidden="true">l</kbd> LOSSES <span class="q">Is the huge loss real spending?</span></h2>
  <p class="lede">Net loss for the nine months to {{ L("Sep 30, 2026") }}: {{ n("is.net_loss.9m2026", "b1") }}. Most of it is an accounting charge, not money spent running the business.</p>
  <div class="split">
    <figure class="chart">
      <figcaption><span class="key s1" aria-hidden="true"></span>Operating loss and <span class="key s2" aria-hidden="true"></span>net loss, by period</figcaption>
      {{ chart("losses.by_year") }}
    </figure>
    <div>
      <details class="fold" open>
      <summary>The same, in figures</summary>
      <table class="grid">
        <caption class="vh">Operating loss and net loss, by period</caption>
        <thead>
          <tr><th scope="col">Period</th><th scope="col">Operating loss</th><th scope="col">Net loss</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">{{ L("2023") }}</th><td>{{ n("is.operating_income.fy2023", "b1") }}</td><td>{{ n("is.net_loss.fy2023", "b1") }}</td></tr>
          <tr><th scope="row">{{ L("2024") }}</th><td>{{ n("is.operating_income.fy2024", "b1") }}</td><td>{{ n("is.net_loss.fy2024", "b1") }}</td></tr>
          <tr><th scope="row">{{ L("2025") }}</th><td>{{ n("is.operating_income.fy2025", "b1") }}</td><td>{{ n("is.net_loss.fy2025", "b1") }}</td></tr>
          <tr><th scope="row">{{ L("First nine months of 2026") }}</th><td>{{ n("is.operating_income.9m2026", "b1") }}</td><td>{{ n("is.net_loss.9m2026", "b1") }}</td></tr>
        </tbody>
      </table>
      </details>
      <p class="aside">The operating loss is what running the business cost beyond its revenue. The gap up to the net loss comes mostly from the accounting charge described below.</p>
    </div>
  </div>

  <div class="cols cols-even">
    <div>
      <h3>Where the nine-month loss comes from</h3>
      <table class="lines bars bars-wide">
        <thead>
          <tr><th scope="col">Source</th><th scope="col">Amount</th><th scope="col">Share</th><th scope="col" class="barcol"><span class="vh">Share, drawn</span></th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">Fair-value changes on notes and derivatives</th><td>{{ n("is.fv_change.9m2026", "b1") }}</td><td>{{ n("losses.share.fair_value", "one") }}</td><td class="barcell">{{ bar(n.share("is.fv_change.9m2026", "is.net_loss.9m2026"), "fg-muted") }}</td></tr>
          <tr><th scope="row">Interest, other items and taxes, net</th><td>{{ n("losses.other_net", "b1") }}</td><td>{{ n("losses.share.other", "one") }}</td><td class="barcell">{{ bar(n.share("losses.other_net", "is.net_loss.9m2026"), "fg-mid") }}</td></tr>
          <tr><th scope="row">Operating loss: running the business</th><td>{{ n("is.operating_income.9m2026", "b1") }}</td><td>{{ n("losses.share.operating", "one") }}</td><td class="barcell">{{ bar(n.share("is.operating_income.9m2026", "is.net_loss.9m2026"), "fg-neg") }}</td></tr>
        </tbody>
      </table>
      <p class="aside">The filing ties the fair-value changes to the rise in the company's own valuation: the more Anthropic is worth, the larger this charge. Of the {{ n("deficit.accumulated", "b1") }} accumulated deficit, {{ n("deficit.fair_value_part", "b1") }} comes from them.</p>
    </div>
    <div>
      <h3>Running the business, first nine months of {{ L("2026") }}</h3>
      <table class="lines bars">
        <tbody>
          <tr><th scope="row">Revenue</th><td>{{ n("is.revenue.9m2026", "b1") }}</td><td class="barcell">{{ bar(100, "fg-pos") }}</td></tr>
          <tr><th scope="row"><span class="op">−</span> compute and infrastructure</th><td>{{ n("is.compute.9m2026", "b1") }}</td><td class="barcell">{{ bar(n.share("is.compute.9m2026", "is.revenue.9m2026"), "fg-s2") }}</td></tr>
          <tr><th scope="row"><span class="op">−</span> sales, marketing, partnerships</th><td>{{ n("is.sales.9m2026", "b1") }}</td><td class="barcell">{{ bar(n.share("is.sales.9m2026", "is.revenue.9m2026"), "fg-s2") }}</td></tr>
          <tr><th scope="row"><span class="op">−</span> other operating costs</th><td>{{ n("is.other_opex.9m2026", "b1") }}</td><td class="barcell">{{ bar(n.share("is.other_opex.9m2026", "is.revenue.9m2026"), "fg-s2") }}</td></tr>
          <tr><th scope="row"><span class="op">−</span> personnel</th><td>{{ n("is.personnel.9m2026", "b1") }}</td><td class="barcell">{{ bar(n.share("is.personnel.9m2026", "is.revenue.9m2026"), "fg-s2") }}</td></tr>
          <tr class="sum"><th scope="row"><span class="op">=</span> operating result</th><td>{{ n("is.operating_income.9m2026", "b1") }}</td><td class="barcell">{{ bar(n.share("is.operating_income.9m2026", "is.revenue.9m2026"), "fg-neg") }}</td></tr>
        </tbody>
      </table>
      <p class="aside">Compute takes more than half of every dollar of revenue. The other costs together take the rest, and a little more.</p>
    </div>
  </div>
</section>

<section class="panel" id="timeline" tabindex="-1" aria-labelledby="timeline-h">
  <h2 id="timeline-h"><kbd aria-hidden="true">t</kbd> TIMELINE <span class="q">Where is the IPO now?</span></h2>
  <ol class="tl">
    {% for m in moments %}
    <li class="tl-{{ m.state }}">
      <span class="tl-day">{% if m.day and m.count > 1 and m.last_day != m.day %}{{ L(day(m.day, "short")) }} <span class="to">→</span> {{ L(day(m.last_day)) }}{% elif m.day %}{{ L(day(m.day)) }}{% elif m.ref == "unlock.01" %}first trading day{% else %}{{ n(m.ref) }}{% endif %}</span>
      <span class="tl-what">{% if m.url %}<a href="{{ m.url }}" rel="noopener" data-label>{{ m.what }}</a>{% else %}{{ L(m.what) }}{% endif %}{% if m.count > 1 %} <span class="what" data-label>× {{ m.count }}</span>{% endif %}{% if m.ref.startswith("press.") %} <span class="what">(reported)</span>{% elif m.ref == "unlock.01" %} <span class="what">· up to {{ n("unlock.01", "m") }} shares</span>{% endif %}</span>
    </li>
    {% endfor %}
  </ol>
  <p class="aside">{% if listed %}Filings come from the SEC's list, read by this page; filings of the same form in a row share a line.{% else %}The SEC's list of filings is not read by this page right now; the line shows the filing the figures come from.{% endif %} The dates of pricing and of the first trade are those reported by the press.</p>
</section>

{% if steps %}
<section class="panel" id="history" tabindex="-1" aria-labelledby="history-h">
  <h2 id="history-h"><kbd aria-hidden="true">h</kbd> HISTORY <span class="q">What changed from one filing to the next?</span></h2>
  <p class="lede">The page reads the latest filing. Earlier ones are kept: every figure that changed is listed here, each side as its filing words it and opening its own source.</p>
  {% macro change_row(c) %}<tr><th scope="row">{{ L(c.title) }}{% if c.when %}<span class="when">{{ n(c.when) }}</span>{% endif %}</th><td>{% if c.before %}{{ n(c.before, c.style) }}{% else %}<span class="what">new</span>{% endif %}</td><td>{% if c.after %}{{ n(c.after, c.style) }}{% else %}<span class="what">no longer given</span>{% endif %}</td></tr>{% endmacro %}
  {% for step in steps %}
  <table class="lines changes">
    <caption>{{ L(step.older.title) }} <span class="what">{{ filed_word(step.older) }} {{ L(day(step.older.filed)) }}</span> <span class="to">→</span> {{ L(step.newer.title) }} <span class="what">{{ filed_word(step.newer) }} {{ L(day(step.newer.filed)) }}</span></caption>
    <thead><tr><th scope="col">figure</th><th scope="col">before</th><th scope="col">after</th></tr></thead>
    <tbody>
      {% for c in step.main %}
      {{ change_row(c) }}
      {% endfor %}
    </tbody>
  </table>
  {% if step.lockup %}
  <details class="fold changes-more">
    <summary>Lock-up steps that changed</summary>
    <table class="lines changes">
      <caption class="vh">Lock-up steps, before and after</caption>
      <tbody>
        {% for c in step.lockup %}
        {{ change_row(c) }}
        {% endfor %}
      </tbody>
    </table>
  </details>
  {% endif %}
  {% endfor %}
  <p class="aside">Every other figure is the same in both filings. When a filing counts a figure another way, as the lock-up table now does with Class A and Class N shares, only the words of each filing tell: open a value to read them.</p>
</section>
{% endif %}

{% if listed %}
<section class="panel filed" id="filings" aria-labelledby="filings-h" tabindex="-1">
  <h2 id="filings-h"><kbd aria-hidden="true">f</kbd> FILINGS <span class="q">What has the company filed with the SEC?</span></h2>
  <table class="lines">
    <caption>The latest filings, newest first</caption>
    <tbody>
      {% for batch in listed %}
      {% set filing = batch.first %}
      <tr><th scope="row">{{ L(day(filing.filed)) }}</th><td><a href="{{ filing.url }}" rel="noopener" data-label>{{ filing.name }}</a>{% if filing.meaning %} <span class="what">{{ L(filing.meaning) }}</span>{% endif %}{% if batch.others %} <span class="more">· same day:{% for other in batch.others %} <a href="{{ other.url }}" rel="noopener" data-label aria-label="{{ other.name }}, document {{ loop.index + 1 }} of that day">{{ loop.index + 1 }}</a>{% endfor %}</span>{% endif %}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="aside">{{ L(filings.source) }}: the list the SEC publishes for {{ document.company }}, asked every ten minutes. {% if price_used %}The offering price comes from the cover of the final prospectus; the other figures of this page come from {{ L(document.title) }}{% else %}The figures of this page come from {{ L(document.title) }}{% endif %}. A newer filing is listed here before its figures are read{% if filings.prospectus and not filings.price %}; the price on the cover of the final prospectus was not taken ({{ L(filings.price_problem) }}){% endif %}.</p>
</section>
{% endif %}

<section class="panel" id="visits" tabindex="-1" aria-labelledby="visits-h">
  <h2 id="visits-h">VISITS <span class="q">How many people read this page?</span></h2>
  <p class="lede v-numbers" hidden><span data-label class="v-today"></span> today · <span data-label class="v-total"></span> since <span data-label class="v-since"></span></p>
  <figure class="chart v-chart" hidden>
    <figcaption class="v-caption"></figcaption>
    <div class="v-plot"></div>
  </figure>
  <p class="aside">Counted once per browser session by this page's script, with no cookie and no address kept: only a number per day and per hour. Robots that do not run scripts are not counted, so the counts are approximate. The same numbers, as data: <a href="/stats">/stats</a>.</p>
  <noscript><p class="aside">The counts are drawn by the page's script, which is off in this browser.</p></noscript>
</section>

</main>

<footer class="bottom">
  <p>Unofficial. Not affiliated with Anthropic. Not investment advice. Figures come from the company's SEC filing and from our own arithmetic. Check the source before relying on any of them.</p>
  <p><a href="{{ loop0_url }}" rel="noopener" data-label>Built with the Loop0 Method</a> · <a href="{{ repository_url }}" rel="noopener">Source code</a> · <span data-label>v{{ version }} · {{ release }} · {{ checks }} consistency checks passed</span></p>
</footer>

<div popover id="help" class="src help">
  <header><strong>Keys</strong></header>
  <dl class="keylist">
    {% if quote %}<div><dt><kbd>m</kbd></dt><dd>market</dd></div>{% endif %}
    <div><dt><kbd>v</kbd></dt><dd>value</dd></div>
    <div><dt><kbd>e</kbd></dt><dd>enterprise value bridge</dd></div>
    <div><dt><kbd>s</kbd></dt><dd>shares</dd></div>
    <div><dt><kbd>u</kbd></dt><dd>unlock</dd></div>
    <div><dt><kbd>k</kbd></dt><dd>control</dd></div>
    <div><dt><kbd>c</kbd></dt><dd>contracts</dd></div>
    <div><dt><kbd>g</kbd></dt><dd>growth</dd></div>
    <div><dt><kbd>l</kbd></dt><dd>losses</dd></div>
    <div><dt><kbd>t</kbd></dt><dd>timeline</dd></div>
    <div><dt><kbd>w</kbd></dt><dd>visits</dd></div>
    {% if steps %}<div><dt><kbd>h</kbd></dt><dd>history: what changed between filings</dd></div>{% endif %}
    {% if listed %}<div><dt><kbd>f</kbd></dt><dd>filings</dd></div>{% endif %}
    <div><dt><kbd>Esc</kbd></dt><dd>close a source card</dd></div>
  </dl>
  <p>Every number is a button, and so is every mark on a chart. Select one to read the passage of the filing it was copied from, or the arithmetic behind it.</p>
  <p>{{ tag("FILED") }} copied from the SEC filing · {{ tag("CALC") }} our arithmetic · {{ tag("PRESS") }} reported by news media</p>
  <p><button type="button" class="close" popovertarget="help" popovertargetaction="hide">close</button></p>
</div>

<div id="tip" class="tip" hidden></div>
<button type="button" id="fresh" class="fresh" hidden>New figures are in · reload</button>

{% for s in n.sources() %}
<div popover id="{{ s.slug }}" class="src src-{{ s.label|lower }}">
  <header>{{ tag(s.label) }} <strong>{{ s.title }}</strong></header>
  <p class="src-value">{{ s.value }}{% if s.period %} <span class="src-period">{{ s.period }}</span>{% endif %}</p>
  {% if s.formula %}
  <p class="src-formula">= {{ s.formula }}</p>
  <table class="src-terms">
    <tbody>
    {% for t in s.terms %}
      <tr><th scope="row">{{ t.name }}</th><td>{{ t.value }}</td><td>{% if t.label %}{{ tag(t.label) }} {{ t.where }}{% else %}constant{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% if s.quote %}
  <blockquote>{% if s.context %}<span class="src-context">{{ s.context }}</span>{% endif %}{{ s.quote }}</blockquote>
  {% endif %}
  {% if s.note %}<p class="src-note">{{ s.note }}</p>{% endif %}
  {% if s.where %}<p class="src-where">{{ s.where }}</p>{% endif %}
  <p class="src-end">{% if s.url %}<a href="{{ s.url }}" rel="noopener">{{ s.link_text }} ↗</a>{% endif %}<button type="button" class="close" popovertarget="{{ s.slug }}" popovertargetaction="hide">close</button></p>
</div>
{% endfor %}

</body>
</html>
