# Every variable the service reads. All are optional: these are the defaults.
# Copy to .env for local use (.env is ignored by git). Never put a secret in this file.

# Address the service listens on. Keep 127.0.0.1 unless something else must reach it.
IPO_HOST=127.0.0.1

# Port the service listens on.
IPO_PORT=8000

# Folder with the fact files (data/facts/*.json).
IPO_FACTS_DIR=data/facts

# Name of the running release, shown in the footer and in /health. Set by deploy/deploy.sh.
IPO_RELEASE=dev

# debug, info, warning or error.
IPO_LOG_LEVEL=info

# Where the share price comes from. All sources are free, unofficial and may be delayed.
# auto (Nasdaq.com, then Yahoo Finance if it fails), nasdaq, yahoo, off (no market panel),
# or file:<path> to replay a recorded answer in tests.
IPO_MARKET=auto
